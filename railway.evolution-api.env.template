# ==========================================
# RAILWAY - EVOLUTION API SERVICE
# ==========================================
# Environment variable template for the Evolution API service on Railway.
# Set these variables in the Railway Dashboard for the Evolution API service.

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Public server URL (provided by Railway after deploy)
# Format: https://your-project.railway.app
SERVER_URL=

# Server type (required)
SERVER_TYPE=https

# Server port (managed automatically by Railway via PORT)
# DO NOT set this variable - Railway handles it automatically
# PORT=8080

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Database provider (postgresql or mysql)
DATABASE_PROVIDER=postgresql

# PostgreSQL connection string (reference to Railway service)
# Use: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Enable database storage for instances
DATABASE_SAVE_DATA_INSTANCE=true

# Enable database storage for messages
DATABASE_SAVE_DATA_NEW_MESSAGE=true

# Enable database storage for message updates
DATABASE_SAVE_MESSAGE_UPDATE=true

# Enable database storage for contacts
DATABASE_SAVE_DATA_CONTACTS=true

# Enable database storage for chats
DATABASE_SAVE_DATA_CHATS=true

# Enable database storage for labels
DATABASE_SAVE_DATA_LABELS=false

# Enable database storage for historical messages
DATABASE_SAVE_DATA_HISTORIC=true

# Connection pool settings
DATABASE_CONNECTION_POOL_MIN=0
DATABASE_CONNECTION_POOL_MAX=10

# Connection client name
DATABASE_CONNECTION_CLIENT_NAME=evolution_api

# ==========================================
# REDIS CONFIGURATION
# ==========================================

# Redis URI (reference to Railway Redis service)
# Use: ${{Redis.REDIS_URL}}
REDIS_URI=

# Redis prefix for keys
REDIS_PREFIX_KEY=evolution_v2

# Enable Redis for caching
CACHE_REDIS_ENABLED=true

# Redis cache TTL in seconds (1 hour)
CACHE_REDIS_TTL=3600

# Save instances in Redis
CACHE_REDIS_SAVE_INSTANCES=true

# Local cache fallback (disabled when Redis is active)
CACHE_LOCAL_ENABLED=false

# ==========================================
# AUTHENTICATION
# ==========================================

# API authentication type (apikey recommended for Railway)
AUTHENTICATION_TYPE=apikey

# Global API key for authentication
# IMPORTANT: Generate a strong, unique key
AUTHENTICATION_API_KEY=

# Expose authentication routes in fetch instances
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# JWT settings (if using JWT instead of apikey)
# AUTHENTICATION_JWT_EXPIRIN_IN=3600
# AUTHENTICATION_JWT_SECRET=

# ==========================================
# WHATSAPP PROVIDER
# ==========================================

# Default WhatsApp provider (baileys, business, or evolution)
PROVIDER_ENABLED=baileys

# External provider host (if using an external provider)
# PROVIDER_HOST=

# External provider port
# PROVIDER_PORT=

# ==========================================
# INSTANCE SETTINGS
# ==========================================

# Delete instance on disconnect
DEL_INSTANCE=false

# Delete temporary instances on startup
DEL_TEMP_INSTANCES=true

# Instance cleanup interval in minutes (8 hours = 480 minutes)
CLEAN_STORE_CLEANING_INTERVAL=480

# Store cleanup settings
CLEAN_STORE_MESSAGES=true
CLEAN_STORE_MESSAGE_UP_TO_DATE=true
CLEAN_STORE_CONTACTS=true
CLEAN_STORE_CHATS=true

# ==========================================
# WEBHOOK CONFIGURATION
# ==========================================

# Global webhook URL (optional)
WEBHOOK_GLOBAL_URL=

# Enable global webhook
WEBHOOK_GLOBAL_ENABLED=false

# Send webhook events individually
# WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=true

# Encode media as base64 in webhooks
WEBHOOK_GLOBAL_WEBHOOK_BASE64=false

# ==========================================
# RABBITMQ (Optional)
# ==========================================

# Enable RabbitMQ
RABBITMQ_ENABLED=false

# RabbitMQ URI (if enabled)
# RABBITMQ_URI=

# RabbitMQ exchange name
# RABBITMQ_EXCHANGE_NAME=evolution_exchange

# ==========================================
# WEBSOCKET (Optional)
# ==========================================

# Enable WebSocket
WEBSOCKET_ENABLED=false

# Enable global WebSocket events
# WEBSOCKET_GLOBAL_EVENTS=true

# ==========================================
# SQS (Optional)
# ==========================================

# Enable AWS SQS
SQS_ENABLED=false

# AWS credentials (if enabled)
# SQS_ACCESS_KEY_ID=
# SQS_SECRET_ACCESS_KEY=
# SQS_REGION=
# SQS_ACCOUNT_ID=

# ==========================================
# S3/MINIO STORAGE (Optional)
# ==========================================

# Enable S3 storage
S3_ENABLED=false

# S3 credentials (if enabled)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_PORT=
# S3_ENDPOINT=
# S3_USE_SSL=true

# ==========================================
# CHATWOOT INTEGRATION (Optional)
# ==========================================

# Enable Chatwoot
CHATWOOT_ENABLED=false

# Chatwoot settings (if enabled)
# CHATWOOT_MESSAGE_READ=true
# CHATWOOT_MESSAGE_DELETE=true
# CHATWOOT_IMPORT_DATABASE=false
# CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_ENABLED=true

# ==========================================
# OPENAI INTEGRATION (Optional)
# ==========================================

# Enable OpenAI
OPENAI_ENABLED=false

# OpenAI API Key (if enabled)
# OPENAI_API_KEY=

# ==========================================
# TYPEBOT INTEGRATION (Optional)
# ==========================================

# Enable Typebot
TYPEBOT_ENABLED=false

# Typebot API version
# TYPEBOT_API_VERSION=latest

# ==========================================
# PROXY CONFIGURATION (Optional)
# ==========================================

# Enable proxy
PROXY_ENABLED=false

# Proxy settings (if enabled)
# PROXY_HOST=
# PROXY_PORT=
# PROXY_PROTOCOL=http
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ==========================================
# LOG CONFIGURATION
# ==========================================

# Log level (ERROR, WARN, DEBUG, INFO, LOG, VERBOSE, DARK, WEBHOOKS)
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG

# Enable colored logs
LOG_COLOR=true

# Baileys log level
LOG_BAILEYS=error

# ==========================================
# LANGUAGE
# ==========================================

# Application language (pt-BR, en)
LANGUAGE=pt-BR

# ==========================================
# SESSION PHONE CONFIGURATION
# ==========================================

# Session client name
CONFIG_SESSION_PHONE_CLIENT=Evolution API

# Session browser name
CONFIG_SESSION_PHONE_NAME=Chrome

# Reject incoming calls automatically
CONFIG_SESSION_PHONE_REJECT_CALL=false

# Webhook on rejected call
CONFIG_SESSION_PHONE_REJECT_CALLS_WEBHOOK=

# Message sent on rejected call
CONFIG_SESSION_PHONE_MSG_REJECT_CALL=

# ==========================================
# QRCODE CONFIGURATION
# ==========================================

# QR code generation limit
QRCODE_LIMIT=30

# QR code color
QRCODE_COLOR=#198754

# ==========================================
# INTEGRATION TOKENS (if using integrations)
# ==========================================

# Typebot
# TYPEBOT_API_KEY=

# Dify
# DIFY_API_KEY=

# Chatwoot
# CHATWOOT_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Evolution Bot
# EVOLUTION_BOT_API_KEY=

# ==========================================
# IMPORTANT NOTES
# ==========================================
# 1. Variables with ${{ServiceName.VARIABLE}} must reference other Railway services
# 2. Generate strong API keys using a password generator
# 3. SERVER_URL must be the public URL provided by Railway
# 4. To use optional integrations, uncomment and configure the relevant sections
# 5. Railway will automatically restart the service when variables are changed
# 6. DO NOT commit this file with real values to the repository
# 7. Use the Railway Dashboard to manage variables securely
