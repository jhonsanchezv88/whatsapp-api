# ============================================================================
# EVOLUTION API - CONFIGURACIÓN DE DESARROLLO LOCAL
# ============================================================================
# Este archivo contiene las variables MÍNIMAS necesarias para ejecutar
# Evolution API localmente con Docker Compose.
# 
# IMPORTANTE: Para producción en Railway, estas variables deben ser
# reemplazadas por valores seguros (credenciales, dominios, etc.)
# ============================================================================

# --- SERVIDOR ---
SERVER_NAME=evolution-local
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

# --- BASE DE DATOS (PostgreSQL) ---
# Asegúrate que coincida con docker-compose.yaml
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@evolution-postgres:5432/evolution_db?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_local
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# --- VARIABLES DE POSTGRES (para docker-compose.yaml) ---
POSTGRES_DATABASE=evolution_db
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=evolution

# --- REDIS (CACHE) ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# --- AUTENTICACIÓN ---
# Esta es la clave API global para desarrolllo local
# En producción, usar una clave segura y única
AUTHENTICATION_API_KEY=test-local-key-429683C4C977415CAAFCCE10F7D57E11
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- WEBHOOKS (desactivados por defecto en desarrollo local) ---
WEBHOOK_GLOBAL_ENABLED=false
# Una vez que tengas una URL pública (ngrok, Railway), activa esto:
# WEBHOOK_GLOBAL_URL=https://tu-dominio.com/webhooks
# WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# Eventos habilitados por defecto (ver sección 4.4 del PRD)
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_MESSAGES_DELETE=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_CONTACTS_UPDATE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true

# --- WHATSAPP / BAILEYS ---
CONFIG_SESSION_PHONE_CLIENT=Evolution-Local
CONFIG_SESSION_PHONE_NAME=Chrome

# --- LOGS ---
LOG_LEVEL=DEBUG,INFO,WARN,ERROR
LOG_COLOR=true
LOG_BAILEYS=error

# --- ALMACENAMIENTO (S3/Cloudflare R2) ---
# Desactivado en desarrollo local
# En producción, configurar credenciales de Cloudflare R2
S3_ENABLED=false
# S3_ENABLED=true
# S3_ACCESS_KEY=your-r2-access-key
# S3_SECRET_KEY=your-r2-secret-key
# S3_BUCKET=logicfy-whatsapp-media
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_USE_SSL=true

# --- INTEGRACIONES (desactivadas por defecto) ---
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false

# --- EVENT BROKERS (desactivados en desarrollo local) ---
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
PUSHER_ENABLED=false
KAFKA_ENABLED=false

# --- IDIOMA ---
LANGUAGE=en

# --- QRCODE ---
QRCODE_LIMIT=30
QRCODE_COLOR='#175197'

# --- DEL INSTANCE (tiempo en minutos para eliminar instancias sin conexión) ---
DEL_INSTANCE=false
